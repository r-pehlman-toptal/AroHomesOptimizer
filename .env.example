# Copy to .env and fill in. Do not commit .env.

# Database (Postgres). Used by API, Query Service, analytics jobs, and refresh_mvs.py.
DB_URL=postgresql+psycopg2://user:password@host:5432/database
# Alternative name some platforms use:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Attom (parcel/address/zoning/AVM). Optional; for Attom-backed address lookup and enrichment.
ATTOM_API_KEY=your_attom_api_key
